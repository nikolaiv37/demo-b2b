# =============================================================================
# Demo B2B — copy to .env and fill in real values before `npm run dev`.
# Client-exposed vars MUST use the VITE_ prefix.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Stripe (optional) -------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# --- PostHog (optional) ------------------------------------------------------
VITE_POSTHOG_KEY=phc_REPLACE_ME
VITE_POSTHOG_HOST=https://app.posthog.com

# --- Sentry (optional) -------------------------------------------------------
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_APP_VERSION=

# --- Dev mode (optional) -----------------------------------------------------
VITE_DEV_MODE=false
