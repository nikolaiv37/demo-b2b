# =============================================================================
# Demo B2B — environment variables
# Fill in real values before running `npm run dev`.
# All client-exposed vars in Vite MUST be prefixed with VITE_.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://jcnrhyacphdvcwqcholb.supabase.co
# Supabase anon/public key (JWT) from Project Settings → API
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpjbnJoeWFjcGhkdmN3cWNob2xiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY3NzA2MDksImV4cCI6MjA5MjM0NjYwOX0.YIR7W_Dyy1Bxw3nf2CkaMm17dr7UsuytpkbnH5mBlEU

# --- Stripe (optional — leave placeholder to disable checkout) ---------------
# Publishable key from Stripe dashboard (starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# --- Resend (optional — used for transactional email from frontend) ----------
# API key from https://resend.com/api-keys (starts with re_)
VITE_RESEND_API_KEY=re_REPLACE_ME

# --- PostHog analytics (optional) --------------------------------------------
# Project API key (starts with phc_)
VITE_POSTHOG_KEY=phc_REPLACE_ME
# PostHog host — use https://app.posthog.com (US) or https://eu.posthog.com (EU)
VITE_POSTHOG_HOST=https://app.posthog.com

# --- Dev mode toggle (optional) ----------------------------------------------
# Set to "true" to enable dev-mode fallback IDs in orders/complaints/CSV import
VITE_DEV_MODE=false
